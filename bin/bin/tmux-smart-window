#!/bin/bash
# =============================================================================
# tmux-smart-window -- Switch to a window, creating it if it doesn't exist
# =============================================================================
# Managed by GNU Stow from ~/dotfiles/bin/bin/tmux-smart-window
#
# For preconfigured TUI windows (6-9, 0):
#   1. If the window exists → switch to it
#   2. If the window DOESN'T exist → create it, launch its app, then switch
#
# For unconfigured windows (1-5): does nothing (handled by plain
# select-window in .tmux.conf).
#
# USAGE:
#   tmux-smart-window <window-number>
#   Called by tmux keybindings (see .tmux.conf)
#
# WINDOW MAP:
#   6 = (disabled)
#   7 = notes (basalt)
#   8 = info (mail+calendar+news, monocle)
#   9 = music (ncmpcpp+cava, side-by-side)
#   0 = scratch (empty shell)
# =============================================================================

WINDOW="$1"
SESSION="command-center"

# Check if the window already exists
if tmux list-windows -t "$SESSION" -F '#{window_index}' 2>/dev/null | grep -q "^${WINDOW}$"; then
    # Window exists -- just switch to it
    tmux select-window -t "$SESSION:$WINDOW"
else
    # Window doesn't exist -- create it with the right app
    case "$WINDOW" in
        # 6) Comms -- disabled
        7)
            tmux new-window -t "$SESSION:7" -n notes
            tmux send-keys -t "$SESSION:7" "basalt" Enter
            ;;
        8)
            # Info: 3 vertical columns (aerc | khal | newsboat), zoom for monocle
            tmux new-window -t "$SESSION:8" -n info
            FIRST=true
            if command -v aerc &> /dev/null; then
                tmux send-keys -t "$SESSION:8" "aerc" Enter
                FIRST=false
            fi
            if command -v khal &> /dev/null; then
                if [ "$FIRST" = false ]; then
                    sleep 0.3
                    tmux split-window -h -t "$SESSION:8" -l 66%
                    tmux send-keys "khal interactive" Enter
                else
                    tmux send-keys -t "$SESSION:8" "khal interactive" Enter
                    FIRST=false
                fi
            fi
            if command -v newsboat &> /dev/null; then
                if [ "$FIRST" = false ]; then
                    sleep 0.3
                    tmux split-window -h -t "$SESSION:8" -l 50%
                    tmux send-keys "newsboat" Enter
                else
                    tmux send-keys -t "$SESSION:8" "newsboat" Enter
                fi
            fi
            tmux select-pane -t "$SESSION:8.0"
            tmux resize-pane -Z -t "$SESSION:8.0"
            ;;
        9)
            tmux new-window -t "$SESSION:9" -n music
            tmux send-keys -t "$SESSION:9" "ncmpcpp" Enter
            if command -v cava &> /dev/null; then
                sleep 0.3
                tmux split-window -h -t "$SESSION:9" -l 40%
                tmux send-keys -t "$SESSION:9.1" "cava" Enter
                tmux select-pane -t "$SESSION:9.0"
            fi
            ;;
        0)
            tmux new-window -t "$SESSION:0" -n scratch
            ;;
        *)
            # For unconfigured windows, do nothing -- don't create empty shells
            exit 0
            ;;
    esac
    tmux select-window -t "$SESSION:$WINDOW"
fi
