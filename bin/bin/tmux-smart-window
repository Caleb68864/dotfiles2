#!/bin/bash
# =============================================================================
# tmux-smart-window -- Switch to a window, creating it if it doesn't exist
# =============================================================================
# Managed by GNU Stow from ~/dotfiles/bin/bin/tmux-smart-window
#
# When you press Alt+number, this script:
#   1. If the window exists → switch to it (normal behavior)
#   2. If the window DOESN'T exist → create it, launch its app, then switch
#
# This means you can never "lose" a window. Accidentally close neomutt?
# Just press Alt+6 and it relaunches automatically.
#
# USAGE:
#   tmux-smart-window <window-number>
#   Called by tmux keybindings (see .tmux.conf)
#
# WINDOW MAP:
#   5 = comms (weechat+gomuks+scli, monocle)
#   6 = notes (basalt)
#   7 = info (mail+calendar+news, monocle)
#   8 = music (ncmpcpp+cava, side-by-side)
#   0 = scratch (empty shell)
# =============================================================================

WINDOW="$1"
SESSION="command-center"

# Check if the window already exists
if tmux list-windows -t "$SESSION" -F '#{window_index}' 2>/dev/null | grep -q "^${WINDOW}$"; then
    # Window exists -- just switch to it
    tmux select-window -t "$SESSION:$WINDOW"
else
    # Window doesn't exist -- create it with the right app
    case "$WINDOW" in
        5)
            # Comms: monocle with weechat + gomuks + scli
            tmux new-window -t "$SESSION:5" -n comms
            FIRST=true
            if command -v weechat &> /dev/null; then
                tmux send-keys -t "$SESSION:5" "weechat" Enter
                FIRST=false
            fi
            if command -v gomuks &> /dev/null; then
                if [ "$FIRST" = false ]; then
                    sleep 0.3
                    tmux split-window -v -t "$SESSION:5" -l 50%
                    tmux send-keys "gomuks" Enter
                else
                    tmux send-keys -t "$SESSION:5" "gomuks" Enter
                    FIRST=false
                fi
            fi
            if command -v scli &> /dev/null; then
                if [ "$FIRST" = false ]; then
                    sleep 0.3
                    tmux split-window -v -t "$SESSION:5" -l 33%
                    tmux send-keys "scli" Enter
                else
                    tmux send-keys -t "$SESSION:5" "scli" Enter
                fi
            fi
            tmux select-pane -t "$SESSION:5.0"
            tmux resize-pane -Z -t "$SESSION:5.0"
            ;;
        6)
            tmux new-window -t "$SESSION:6" -n notes
            tmux send-keys -t "$SESSION:6" "basalt" Enter
            ;;
        7)
            # Info: monocle with neomutt + khal + newsboat
            tmux new-window -t "$SESSION:7" -n info
            FIRST=true
            if command -v neomutt &> /dev/null; then
                tmux send-keys -t "$SESSION:7" "neomutt" Enter
                FIRST=false
            fi
            if command -v khal &> /dev/null; then
                if [ "$FIRST" = false ]; then
                    sleep 0.3
                    tmux split-window -v -t "$SESSION:7" -l 50%
                    tmux send-keys "khal interactive" Enter
                else
                    tmux send-keys -t "$SESSION:7" "khal interactive" Enter
                    FIRST=false
                fi
            fi
            if command -v newsboat &> /dev/null; then
                if [ "$FIRST" = false ]; then
                    sleep 0.3
                    tmux split-window -v -t "$SESSION:7" -l 33%
                    tmux send-keys "newsboat" Enter
                else
                    tmux send-keys -t "$SESSION:7" "newsboat" Enter
                fi
            fi
            tmux select-pane -t "$SESSION:7.0"
            tmux resize-pane -Z -t "$SESSION:7.0"
            ;;
        8)
            tmux new-window -t "$SESSION:8" -n music
            tmux send-keys -t "$SESSION:8" "ncmpcpp" Enter
            if command -v cava &> /dev/null; then
                sleep 0.3
                tmux split-window -h -t "$SESSION:8" -l 40%
                tmux send-keys -t "$SESSION:8.1" "cava" Enter
                tmux select-pane -t "$SESSION:8.0"
            fi
            ;;
        0)
            tmux new-window -t "$SESSION:0" -n scratch
            ;;
        *)
            # For working windows (1-4), just create an empty shell
            tmux new-window -t "$SESSION:$WINDOW"
            ;;
    esac
    tmux select-window -t "$SESSION:$WINDOW"
fi
