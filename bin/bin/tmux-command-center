#!/bin/bash
# =============================================================================
# tmux-command-center -- Create the command-center tmux session with TUI apps
# =============================================================================
# Managed by GNU Stow from ~/dotfiles/bin/bin/tmux-command-center
#
# This script creates the main tmux session with pre-configured windows for
# all your TUI (Terminal User Interface) apps. It runs automatically when you
# open your FIRST terminal -- subsequent terminals join the existing session
# via grouped sessions (see .zshrc).
#
# WINDOW LAYOUT:
#   Window 1:    tactical  -- Your default working shell (Alt+1)
#   Window 2-5:  (open)    -- User-created, pi-workspace agent, etc.
#   Window 6:    comms     -- weechat + gomuks + scli (Alt+6, monocle)
#   Window 7:    notes     -- basalt Obsidian vault browser (Alt+7)
#   Window 8:    info      -- mail + calendar + news (Alt+8, monocle)
#   Window 9:    music     -- ncmpcpp + cava split panes (Alt+9)
#   Window 0:    scratch   -- Empty shell for quick one-offs (Alt+0)
#
# MONOCLE MODE (windows 6 and 8):
#   Multiple apps share one window, each as a full-screen pane.
#   The first pane is zoomed by default (fills the whole window).
#   To switch between apps:
#     prefix+o  = cycle to next app (stays full-screen)
#     prefix+z  = unzoom to see all apps as split panes
#     prefix+z  = zoom back to full-screen on current app
#
# GROUPING:
#   Comms at 6, Notes at 7, Info at 8, Music at 9
#   Working windows fill 1-5, TUI apps at 6-9
#
# POPUP TOOLS (not windows, toggled on demand):
#   prefix+Ctrl+c  -- Claude Code popup
#   prefix+Ctrl+p  -- Pi popup
#
# ALIAS-ONLY TOOLS (launch when needed, not auto-started):
#   btop, pulsemixer, bluetuith, basalt -- see aliases.zsh
#
# TUI apps are pinned to windows 6-9 (right side of keyboard).
# Working windows auto-fill slots 2-5. Window 0 is scratch.
#
# Additional windows (like "agent" for Pi workspace) are created on demand
# by other scripts like pi-workspace.
#
# USAGE:
#   Called automatically by .zshrc on first terminal open.
#   Can also be run manually: ~/bin/tmux-command-center
# =============================================================================

SESSION="command-center"

# If the session already exists (e.g., restored by tmux-continuum), just attach.
# This prevents duplicate windows when continuum auto-restores a saved session
# and this script also tries to create windows from scratch.
if tmux has-session -t "$SESSION" 2>/dev/null; then
    exec tmux attach -t "$SESSION"
fi

# --- Window 1: tactical (default shell) ---
# This is your main working terminal -- where you type commands, edit files, etc.
# It's created as part of the session itself (the -n flag names it).
tmux new-session -d -s "$SESSION" -n tactical

# =========================================================================
# TUI Apps -- Pinned to windows 5-0 (right side of keyboard)
# =========================================================================
# These use explicit window numbers (-t SESSION:NUMBER) so they always
# live at the end of the window list. New working windows auto-fill
# slots 2-4 without displacing these.
#
# "command -v" checks if a program exists; skips if not installed.
# This means on a fresh system, only installed apps get windows.

# --- Window 6: comms (monocle: weechat + gomuks + scli) ---
# All chat apps stacked as panes, first one zoomed to full-screen.
# prefix+o = cycle to next chat app (stays zoomed/full-screen)
# prefix+z = unzoom to see all as split panes, then zoom back
COMMS_CREATED=false
if command -v weechat &> /dev/null; then
    tmux new-window -t "$SESSION:6" -n comms
    tmux send-keys -t "$SESSION:6" "weechat" Enter
    COMMS_CREATED=true
fi
if command -v gomuks &> /dev/null; then
    if [ "$COMMS_CREATED" = true ]; then
        tmux split-window -v -t "$SESSION:6" -l 50%
        tmux send-keys "gomuks" Enter
    else
        tmux new-window -t "$SESSION:6" -n comms
        tmux send-keys -t "$SESSION:6" "gomuks" Enter
        COMMS_CREATED=true
    fi
fi
if command -v scli &> /dev/null; then
    if [ "$COMMS_CREATED" = true ]; then
        tmux split-window -v -t "$SESSION:6" -l 33%
        tmux send-keys "scli" Enter
    else
        tmux new-window -t "$SESSION:6" -n comms
        tmux send-keys -t "$SESSION:6" "scli" Enter
        COMMS_CREATED=true
    fi
fi
# Zoom the first pane so you start with one app full-screen
if [ "$COMMS_CREATED" = true ]; then
    tmux select-pane -t "$SESSION:6.0"
    tmux resize-pane -Z -t "$SESSION:6.0"
fi

# --- Window 7: notes (basalt) ---
# Full-screen Obsidian vault browser. Renders markdown, understands wikilinks.
# Press Ctrl+Alt+E inside basalt to open a note in Neovim.
if command -v basalt &> /dev/null; then
    tmux new-window -t "$SESSION:7" -n notes
    tmux send-keys -t "$SESSION:7" "basalt" Enter
fi

# --- Window 8: info (monocle: mail + calendar + news) ---
# All info apps stacked as panes, first one zoomed to full-screen.
# prefix+o = cycle between aerc, khal, newsboat (stays full-screen)
# prefix+z = unzoom to see all three, then zoom back
INFO_CREATED=false
if command -v aerc &> /dev/null; then
    tmux new-window -t "$SESSION:8" -n info
    tmux send-keys -t "$SESSION:8" "aerc" Enter
    INFO_CREATED=true
fi
if command -v khal &> /dev/null; then
    if [ "$INFO_CREATED" = true ]; then
        tmux split-window -v -t "$SESSION:8" -l 50%
        tmux send-keys "khal interactive" Enter
    else
        tmux new-window -t "$SESSION:8" -n info
        tmux send-keys -t "$SESSION:8" "khal interactive" Enter
        INFO_CREATED=true
    fi
fi
if command -v newsboat &> /dev/null; then
    if [ "$INFO_CREATED" = true ]; then
        tmux split-window -v -t "$SESSION:8" -l 33%
        tmux send-keys "newsboat" Enter
    else
        tmux new-window -t "$SESSION:8" -n info
        tmux send-keys -t "$SESSION:8" "newsboat" Enter
        INFO_CREATED=true
    fi
fi
# Zoom the first pane so you start with mail full-screen
if [ "$INFO_CREATED" = true ]; then
    tmux select-pane -t "$SESSION:8.0"
    tmux resize-pane -Z -t "$SESSION:8.0"
fi

# --- Window 9: music (ncmpcpp + cava) ---
# Music player on the left (60%), audio visualizer on the right (40%).
# These are side-by-side (not monocle) because cava is visual + music together.
if command -v ncmpcpp &> /dev/null; then
    tmux new-window -t "$SESSION:9" -n music
    tmux send-keys -t "$SESSION:9" "ncmpcpp" Enter
    if command -v cava &> /dev/null; then
        tmux split-window -h -t "$SESSION:9" -l 40%
        tmux send-keys -t "$SESSION:9.1" "cava" Enter
        tmux select-pane -t "$SESSION:9.0"
    fi
fi

# --- Window 0: scratch (empty shell) ---
# A spare shell for quick one-off commands. Out of the way at Alt+0.
tmux new-window -t "$SESSION:0" -n scratch

# --- Focus on window 1 (tactical) ---
# When tmux attaches, you want to land on your working shell, not on
# btop or aerc. This selects window 1 before attaching.
tmux select-window -t "$SESSION:tactical"

# --- Attach to the session ---
# "exec" replaces the current shell process with tmux (no leftover shell
# sitting underneath using memory).
exec tmux attach -t "$SESSION"
