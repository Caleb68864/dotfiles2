# =============================================================================
# Tokyo Night Color Theme for NeoMutt
# =============================================================================
# Managed by GNU Stow from ~/dotfiles/neomutt/colors/tokyonight.muttrc
#
# This theme matches the Tokyo Night "night" variant used across the rest
# of the system (Hyprland, Waybar, Kitty, Neovim, Tmux).
#
# Color reference:
#   color0  = black     #15161e    color8  = bright black   #414868
#   color1  = red       #f7768e    color9  = bright red     #f7768e
#   color2  = green     #9ece6a    color10 = bright green   #9ece6a
#   color3  = yellow    #e0af68    color11 = bright yellow  #e0af68
#   color4  = blue      #7aa2f7    color12 = bright blue    #7aa2f7
#   color5  = magenta   #bb9af7    color13 = bright magenta #bb9af7
#   color6  = cyan      #7dcfff    color14 = bright cyan    #7dcfff
#   color7  = white     #a9b1d6    color15 = bright white   #c0caf5
#
# NeoMutt supports truecolor with "color" using #rrggbb hex values when
# the terminal supports it (Kitty does).
# =============================================================================

# --- Reset all colors to default first ---
color normal        default default

# --- General UI ---
# The main text: light blue-white on dark background
color normal        color15 default
# Status bar at the top/bottom: bright text on medium dark background
color status        color15 color8
# Error messages: red on dark
color error         color1  default
# Warning/info messages: yellow on dark
color message       color3  default

# --- Index (message list) ---
# Regular messages: soft gray text
color index         color7  default "~A"
# Unread messages: bright white (stands out from read messages)
color index         color15 default "~U"
# Flagged/starred messages: yellow (important!)
color index         color3  default "~F"
# Deleted messages: dim red with strikethrough feel
color index         color8  default "~D"
# Tagged messages (selected with t): magenta/purple
color index         color5  default "~T"
# New messages: bright green (fresh and unread)
color index         color2  default "~N"

# --- Index date, sender, subject highlighting ---
color index_date    color4  default
color index_author  color6  default ".*"
color index_subject color15 default ".*"

# --- Sidebar (folder list) ---
# Normal folders: soft gray
color sidebar_ordinary   color7  default
# Folder with new mail: bright blue (draws your eye)
color sidebar_new        color4  default
# Currently highlighted folder: bright text on medium background
color sidebar_highlight  color15 color8
# The divider line between sidebar and content
color sidebar_divider    color8  default
# Flagged folder: yellow
color sidebar_flagged    color3  default

# --- Message body (reading an email) ---
# Regular text
color body          color15 default ".*"
# URLs: blue and underlined (clickable feel)
color body          color4  default "(https?|ftp)://[^ \t\n\r]+"
# Email addresses: cyan
color body          color6  default "[-a-z_0-9.]+@[-a-z_0-9.]+"
# Bold text: bright white
color bold          color15 default
# Underlined text: blue
color underline     color4  default

# --- Headers (when viewing full email headers) ---
color hdrdefault    color8  default
color header        color4  default "^(From|To|Cc|Bcc):"
color header        color5  default "^(Subject):"
color header        color3  default "^(Date):"
color header        color6  default "^(X-|User-Agent|Message-ID):"

# --- Compose (writing an email) ---
color compose header            color15 default
color compose security_encrypt  color2  default
color compose security_sign     color4  default
color compose security_both     color6  default
color compose security_none     color1  default

# --- Quoted text (replies, > prefixed lines) ---
# Each level of quoting gets a different color so you can tell who said what
color quoted        color4  default    # Level 1: blue
color quoted1       color5  default    # Level 2: purple
color quoted2       color6  default    # Level 3: cyan
color quoted3       color2  default    # Level 4: green
color quoted4       color3  default    # Level 5: yellow

# --- Attachment list ---
color attachment    color5  default

# --- Search results ---
color search        color0  color3     # Black text on yellow background

# --- Tree characters (thread view) ---
color tree          color8  default

# --- Indicators ---
# The arrow or highlight showing which message is selected
color indicator     color15 color4     # Bright white on blue (active selection)

# --- Progress bar ---
color progress      color15 color4
