# =============================================================================
# Editor Aliases
# =============================================================================
# All three of these open Neovim (nvim). This way, no matter which
# old habit you have — typing "vim", "vi", or just "v" — you always
# get Neovim. Neovim is the modern, improved version of Vim.
alias vim='nvim'
alias vi='nvim'
alias v='nvim'
