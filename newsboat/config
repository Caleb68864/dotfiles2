# =============================================================================
# Newsboat Configuration
# =============================================================================
# Managed by GNU Stow from ~/dotfiles/newsboat/config
# Stow target: ~/.config/newsboat/config
#
# Newsboat is a terminal RSS/Atom feed reader. You subscribe to websites,
# blogs, YouTube channels, and GitHub releases and read them all in one
# place without opening a browser.
#
# Usage:
#   newsboat           -- Open newsboat
#   r                  -- Reload current feed
#   R                  -- Reload all feeds
#   o                  -- Open article in browser
#   b                  -- Bookmark article (saves to Obsidian vault)
#   q                  -- Quit / go back
# =============================================================================


# =============================================================================
# General Settings
# =============================================================================

# How often to auto-reload feeds (in minutes). 0 = don't auto-reload.
auto-reload yes
reload-time 30

# Number of threads for parallel feed downloading (faster reloads)
reload-threads 4

# Notify when new articles arrive (shows count)
notify-always yes
notify-format "newsboat: %n new articles"

# Show article dates in a clean format
datetime-format "%Y-%m-%d %H:%M"

# Default browser for opening articles
browser "xdg-open %u"

# Maximum number of articles to keep per feed (0 = unlimited)
max-items 200

# Confirm before quitting
confirm-exit no

# =============================================================================
# Podboat (podcast downloader/player)
# =============================================================================
# Podboat is a separate program, not built into newsboat.
# Workflow: press 'e' on a podcast episode to enqueue → run 'podboat' to play.
#
# In podboat:
#   d = download episode
#   p = play episode
#   c = cancel download
#   D = delete downloaded file
#   q = quit
player "mpv"
download-path "~/Podcasts/%n/"

# Use vim-style keybindings
bind-key j down
bind-key k up
bind-key j next articlelist
bind-key k prev articlelist
bind-key J next-feed articlelist
bind-key K prev-feed articlelist
bind-key G end
bind-key g home
bind-key l open
bind-key h quit
bind-key n next-unread
bind-key N prev-unread
bind-key m toggle-article-read
bind-key f edit-flags
bind-key F set-filter
bind-key BACKSPACE clear-filter

# =============================================================================
# Macros (prefix: , )
# =============================================================================
# Usage: press , then the macro key.
#
#   ,m  = Stream in mpv (YouTube, podcasts, etc.)
#   ,o  = Clip to Obsidian vault (Markdown note)
#   ,c  = Copy URL to clipboard
#   ,d  = Download with yt-dlp
#
# Flags (press f then type the flag character):
#   w = To-Watch    r = To-Read    s = Saved
#   (clear by pressing f and entering empty string)
# Filters: F = set filter, Backspace = clear filter

# Stream in mpv (detached so newsboat isn't blocked)
macro m set browser "~/.config/newsboat/scripts/newsboat-to-mpv %u" ; open-in-browser ; set browser "xdg-open %u"

# Clip to Obsidian vault
macro o set browser "~/.config/newsboat/scripts/newsboat-to-obsidian %u %t" ; open-in-browser ; set browser "xdg-open %u"

# Copy URL to clipboard
macro c set browser "wl-copy %u" ; open-in-browser ; set browser "xdg-open %u"

# Download with yt-dlp
macro d set browser "yt-dlp -o '~/Downloads/%(title)s.%(ext)s' %u &" ; open-in-browser ; set browser "xdg-open %u"

# =============================================================================
# Article flags
# =============================================================================
# Newsboat flags are single characters stored per-article. Press F to set flags
# manually, or use the macros above.
#
# Flag convention:
#   w = To-Watch (video/podcast content to watch later)
#   r = To-Read  (articles/blogs to read later)
#   s = Saved    (permanently bookmarked)
#
# Query feeds (add these to your urls file) create filtered views:
#   "query:To-Watch:flags # \"w\"" "virtual"
#   "query:To-Read:flags # \"r\"" "virtual"
#   "query:Saved:flags # \"s\"" "virtual"


# =============================================================================
# Tokyo Night Color Theme
# =============================================================================
# Colors use the format: color <element> <foreground> <background> [<attribute>]
#
# Available colors: black, red, green, yellow, blue, magenta, cyan, white
# Plus color0-color255 for 256-color terminals.
# Attributes: bold, underline, standout, blink
#
# Tokyo Night palette mapping:
#   bg:     color0/black     (#1a1b26)
#   bg2:    color8           (#414868)
#   fg:     color15/white    (#c0caf5)
#   fg dim: color7           (#a9b1d6)
#   blue:   color4           (#7aa2f7)
#   purple: color5           (#bb9af7)
#   cyan:   color6           (#7dcfff)
#   green:  color2           (#9ece6a)
#   yellow: color3           (#e0af68)
#   red:    color1           (#f7768e)
# =============================================================================

# --- Article list ---
# Regular articles: soft gray text on dark background
color article        color15  default

# --- List items (feeds and articles) ---
# Normal list text
color listnormal     color7   default
# Unread list items: bright white (stands out)
color listnormal_unread color15 default bold
# Currently selected item: bright text on blue background
color listfocus      color15  color4   bold
# Currently selected + unread: same but extra emphasis
color listfocus_unread color15 color4  bold

# --- Info bar (status line at top/bottom) ---
color info           color15  color8   bold

# --- Highlighted text in article view ---
highlight article "^(Feed|Title|Author|Link|Date):.*" color4 default bold

# --- Flag-based article highlighting ---
# To-Watch articles: cyan (video content)
highlight-article "flags # \"w\"" color6 default bold
# To-Read articles: purple (text content)
highlight-article "flags # \"r\"" color5 default bold
# Saved articles: green
highlight-article "flags # \"s\"" color2 default bold

# --- Hint keys (one-key shortcuts) ---
color hint-key       color4   default  bold
color hint-keys-delimiter color8 default

# --- Title bar ---
color title          color4   default  bold

# =============================================================================
# Feed display format
# =============================================================================

# How feeds are displayed in the feed list
# %4i = index, %n = new flag, %u = unread/total, %T = first tag, %t = title
feedlist-format "%4i %n %11u  %-12T  %t"

# How articles are displayed in the article list
# %D = date, %f = feed title, %T = tag, %F = flags, %t = article title
articlelist-format "%D  %f  %?T?|%-17T|  ?%?F?[%F] ?%t"


# =============================================================================
# Tag-based highlighting
# =============================================================================
# Colors by category using Tokyo Night palette:
#   blue   (color4)  = dev / systems / architecture
#   cyan   (color6)  = linux / arch / endeavouros / unix / suckless
#   green  (color2)  = maker / hardware / electronics / 3dprinting / prusa
#   red    (color1)  = security / privacy / networking
#   purple (color5)  = writing / fantasy / fiction / scifi / sanderson
#   yellow (color3)  = rpg / games / freeleague / mongoose / pinnacle
#   magenta(color13) = podcast / music / metal
#   white  (color15) = news / commentary / analysis / blog
#   color8 (gray)    = deals / bundles / freebies / humble / indiegamebundles / bundleofholding

# --- Dev / Systems (blue) ---
highlight feedlist "dev|dotnet|github|architecture|systems|guide" color4 default bold
highlight articlelist "dev|dotnet|github|architecture|systems|guide" color4 default bold

# --- Linux / OS (cyan) ---
highlight feedlist "linux|arch|endeavouros|unix|suckless|distrotube" color6 default bold
highlight articlelist "linux|arch|endeavouros|unix|suckless|distrotube" color6 default bold

# --- Maker / Hardware (green) ---
highlight feedlist "maker|hardware|electronics|3dprinting|prusa|homelab|selfhost" color2 default bold
highlight articlelist "maker|hardware|electronics|3dprinting|prusa|homelab|selfhost" color2 default bold

# --- Security / Privacy (red) ---
highlight feedlist "security|privacy|networking|darknetdiaries|tactical" color1 default bold
highlight articlelist "security|privacy|networking|darknetdiaries|tactical" color1 default bold

# --- Writing / Fiction (purple) ---
highlight feedlist "writing|fantasy|fiction|scifi|sanderson|science" color5 default bold
highlight articlelist "writing|fantasy|fiction|scifi|sanderson|science" color5 default bold

# --- RPG / Games (yellow) ---
highlight feedlist "rpg|games|freeleague|mongoose|pinnacle|bundleofholding" color3 default bold
highlight articlelist "rpg|games|freeleague|mongoose|pinnacle|bundleofholding" color3 default bold

# --- Podcast / Music (magenta) ---
highlight feedlist "podcast|music|metal|jupiter|linuxunplugged" color13 default bold
highlight articlelist "podcast|music|metal|jupiter|linuxunplugged" color13 default bold

# --- News / Commentary (bright white) ---
highlight feedlist "news|commentary|analysis|blog|discovery" color15 default
highlight articlelist "news|commentary|analysis|blog|discovery" color15 default

# --- Deals / Bundles (gray) ---
highlight feedlist "deals|bundles|freebies|humble|indiegamebundles" color8 default
highlight articlelist "deals|bundles|freebies|humble|indiegamebundles" color8 default

# --- People / Creators (cyan, no bold — subtler than category tags) ---
highlight feedlist "creator|brodie|lukesmith|mentaloutlaw|networkchuck|nicknisi|theprimeagen|timcast|timcastirl|shawnryan|unsubscribe" color6 default
highlight articlelist "creator|brodie|lukesmith|mentaloutlaw|networkchuck|nicknisi|theprimeagen|timcast|timcastirl|shawnryan|unsubscribe" color6 default

# --- Microsoft (blue, no bold) ---
highlight feedlist "microsoft" color4 default
highlight articlelist "microsoft" color4 default


# =============================================================================
# URLs file
# =============================================================================
# Feeds go in ~/.config/newsboat/urls, one per line:
#
#   https://hnrss.org/newest "~Hacker News" "news"
#   https://lukesmith.xyz/rss.xml "~Luke Smith" "linux" "people"
#
# The "~Name" sets a display name. Other quoted strings are tags.
#
# --- Query feeds (filtered views) ---
# Add these lines to your urls file for flag-based filtered views:
#
#   "query:To-Watch:flags # \"w\"" "virtual"
#   "query:To-Read:flags # \"r\"" "virtual"
#   "query:Saved:flags # \"s\"" "virtual"
#
# These appear as virtual feeds at the top of your feed list.
# Flag articles with F then type w/r/s, or use the ,w ,r ,s macros.
